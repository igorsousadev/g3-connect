# Public Vite configuration (embedded in the browser bundle)
VITE_APP_NAME=your-app-name
VITE_APP_URL=https://app.example.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPPORT_WHATSAPP=your-support-number
VITE_SUPPORT_EMAIL=support@example.com

# Supabase Edge Function configuration
# Configure these with `supabase secrets set`; never expose them as VITE_ variables.
APP_NAME=your-app-name
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Dropbox OAuth (server only)
DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret
DROPBOX_REFRESH_TOKEN=your-dropbox-refresh-token
DROPBOX_ROOT_FOLDER=/your-app-folder

# SMTP (server only)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com

# Optional Cloudflare/Wrangler automation (never expose as VITE_ variables)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
